// Configuracion del Worker de fotos. Se publica con:  npx wrangler@4 deploy   (desde esta carpeta)
// OWNER_UID (tu UID de Firebase) se guarda como secreto:  npx wrangler@4 secret put OWNER_UID
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aphillips-fotos",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "routes": [
    { "pattern": "api.aphillipsstore.com", "custom_domain": true }
  ],
  "r2_buckets": [
    { "binding": "FOTOS", "bucket_name": "aphillips-photos" },
    // PRIVADO (sin dominio publico): respaldos diarios con datos del negocio
    { "binding": "RESPALDOS", "bucket_name": "aphillips-respaldos" }
  ],
  // Correos de la tienda (verificacion de cuenta y contrasena) con Cloudflare Email Sending.
  // Solo puede enviar desde noreply@. Ademas necesita el secreto FIREBASE_SA (llave de servicio de Firebase).
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["noreply@aphillipsstore.com"] }],
  // Respaldo y limpieza diaria: 08:00 UTC = 3:00 a. m. en Panama
  "triggers": { "crons": ["0 8 * * *"] },
  // Metricas del catalogo (vistas / aperturas / clics)
  "d1_databases": [
    { "binding": "DB", "database_name": "aphillips-db", "database_id": "c034e54e-c004-456d-b31c-58146a31f1a5", "migrations_dir": "migrations" }
  ],
  "vars": {
    "FIREBASE_PROJECT_ID": "aphillips-store-733df",
    "FOTOS_URL_BASE": "https://fotos.aphillipsstore.com",
    // Informe semanal por correo a info@ los lunes: "1" = activado, "0" = apagado
    "INFORME_SEMANAL": "0",
    "ORIGENES_PERMITIDOS": "https://aphillipsstore.com,https://www.aphillipsstore.com,https://aphillips7.github.io,http://localhost:8765"
  },
  "observability": { "enabled": true }
}

rules_version = '2';

// Reglas de Firestore de APHILLIPS STORE (despues de la etapa 3c).
// Los datos de la tienda viven en Cloudflare. Firestore queda como ARCHIVO HISTORICO de solo
// lectura: solo el admin puede leerlo (p. ej. para consultar algo viejo o importar metricas
// antiguas una vez) y nadie puede escribir. El catalogo publico ya no se lee de aqui.
//
// ANTES DE PUBLICAR: reemplaza PEGA_AQUI_TU_UID por el UID de tu usuario admin
// (Firebase Console > Authentication > Users > columna "User UID").
// Se publican a mano: Firebase Console > Firestore Database > Reglas > pegar > Publicar.

service cloud.firestore {
  match /databases/{database}/documents {

    // Solo tu cuenta (por UID, no por correo) es administradora.
    function esAdmin() {
      return request.auth != null && request.auth.uid == 'PEGA_AQUI_TU_UID';
    }

    // Todo: solo lectura para el admin; escrituras cerradas para todos.
    match /{coleccion}/{id} {
      allow read: if esAdmin();
      allow write: if false;
    }
  }
}

// Tienda en Cloudflare (aphillipsstore.com): Worker "aphillipsstore", conectado a GitHub (Workers Builds).
// Se publica sola con cada push a main (Workers Builds) o a mano con:  npx wrangler@4 deploy
// El Worker de fotos (api.aphillipsstore.com) esta aparte, en cloudflare/fotos-worker/.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aphillipsstore",
  "main": "cloudflare/tienda-worker/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "routes": [
    { "pattern": "aphillipsstore.com", "custom_domain": true },
    { "pattern": "www.aphillipsstore.com", "custom_domain": true }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "404-page",
    "run_worker_first": ["/__/*", "/", "/admin", "/admin/", "/manifest.json", "/sitemap.xml", "/favicon.ico", "/legal", "/legal.html", "/preguntas", "/preguntas.html", "/guia-de-tamanos", "/guia-de-tamanos.html", "/index.html", "/catalogo.html", "/relojes", "/relojes-hombre", "/relojes-mujer", "/invicta", "/bulova", "/technomarine"]
  },
  // La API (Worker aphillips-fotos), para leer el catalogo al armar la vista previa de un reloj
  "services": [{ "binding": "API", "service": "aphillips-fotos" }],
  "observability": { "enabled": true }
}
